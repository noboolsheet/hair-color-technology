#--- DOCKER (profilo prod: sito VIVO della cliente, pubblico via Caddy) ---#
DOCKER_PROFILE="prod"
# Rete CONDIVISA del server, non una propria. Prima era "hct_network", e per
# questo Caddy non poteva raggiungere il container per nome.
DOCKER_NETWORK="noboolsheet_network"
# vibox non ha IP pubblico né porte aperte: 0.0.0.0 qui significa la LAN di
# casa e il tailnet. La porta pubblica del sito passa da Cloudflare Tunnel.
DOCKER_IFACE="0.0.0.0"

#--- HAIR COLOR TECHNOLOGY (SPA Vite + server Express in un solo container) ---#
DOCKER_HCT_APP_DDNS="haircolortechnology.app"
# 4252 e non 4250: la convenzione è 42X0 dev / 42X2 prod (vedi nbs-infra/docs/PORTS.md).
# In precedenza prod usava 4250, la stessa porta di dev.
HCT_APP_EPORT="4252"
HCT_APP_IPORT="3000"
HCT_APP_IFACE="${DOCKER_IFACE}"
# Destinatario dei moduli. GMAIL_USER e la App Password vivono in web/.env.prod (gitignored).
HCT_CONTACT_TO="haircolortechnology@gmail.com"
