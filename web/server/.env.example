# ─────────────────────────────────────────────────────────────────────────
#  Configurazione email per i moduli (contatti + candidature) via Gmail.
#  Copia questo file in ".env" nella RADICE del progetto e compila i valori.
#  In produzione (Docker/VPS) le stesse variabili vengono passate dal deploy.
# ─────────────────────────────────────────────────────────────────────────

# Account Gmail che INVIA i messaggi.
GMAIL_USER=iltuosalone@gmail.com

# "App Password" a 16 cifre generata da Google (NON la password normale):
# Account Google → Sicurezza → Verifica in due passaggi → Password per le app.
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Destinatario dei moduli (dove arrivano le email). Se vuoto, usa GMAIL_USER.
CONTACT_TO=info@haircolortechnology.it

# Porta del server (facoltativa; default 8787 in locale, 3000 in container).
PORT=8787
